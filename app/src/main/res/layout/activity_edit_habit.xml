<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg"
    tools:context=".EditHabitActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_edit_habit"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/ios_primary_label"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="20dp" />

        <!-- 习惯名称卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_ios_card"
            android:elevation="0dp"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_habit_name"
                android:textSize="13sp"
                android:textColor="@color/ios_secondary_label"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/ed_title"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_habit_title_edit"
                android:textSize="15sp"
                android:textColor="@color/ios_primary_label"
                android:textColorHint="@color/ios_secondary_label"
                android:background="@android:color/transparent"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/ios_separator"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- 习惯描述卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_ios_card"
            android:elevation="0dp"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_habit_desc"
                android:textSize="13sp"
                android:textColor="@color/ios_secondary_label"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/ed_content"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="@string/hint_habit_desc_edit"
                android:gravity="top"
                android:textSize="15sp"
                android:textColor="@color/ios_primary_label"
                android:textColorHint="@color/ios_secondary_label"
                android:background="@android:color/transparent"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />

        </LinearLayout>

        <!-- 照片卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_ios_card"
            android:elevation="0dp"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_change_photo"
                android:textSize="13sp"
                android:textColor="@color/ios_secondary_label"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center">

                <ImageView
                    android:id="@+id/iv_image"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/default_avatar"
                    android:scaleType="centerCrop" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/bt_camera"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/btn_camera"
                    android:textSize="15sp"
                    android:textColor="@color/ios_blue"
                    android:background="@drawable/bg_btn_ghost"
                    android:textAllCaps="false"
                    android:elevation="0dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/bt_photo"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/btn_photo"
                    android:textSize="15sp"
                    android:textColor="@color/ios_blue"
                    android:background="@drawable/bg_btn_ghost"
                    android:textAllCaps="false"
                    android:elevation="0dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/bt_update"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/btn_update_habit"
            android:textSize="15sp"
            android:textColor="@color/ios_surface"
            android:background="@drawable/bg_btn_primary"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:elevation="0dp" />

    </LinearLayout>

</ScrollView>
