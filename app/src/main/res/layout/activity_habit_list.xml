<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/page_home"
                layout="@layout/page_home"
                android:visibility="visible" />

            <include
                android:id="@+id/page_profile"
                layout="@layout/page_profile"
                android:visibility="gone" />

        </FrameLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_bottom_nav_pill"
            app:menu="@menu/bottom_nav_menu"
            app:labelVisibilityMode="labeled"
            app:itemIconTint="@drawable/bottom_nav_color"
            app:itemTextColor="@drawable/bottom_nav_color"
            app:itemTextAppearanceActive="@style/BottomNavActive"
            app:itemTextAppearanceInactive="@style/BottomNavInactive"
            app:itemRippleColor="@color/monet_primary_container"
            android:elevation="0dp" />

    </LinearLayout>

    <!-- FAB - Center bottom, overlapping navigation bar -->
    <FrameLayout
        android:id="@+id/bt_add"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="80dp"
        android:background="@drawable/bg_fab"
        android:elevation="6dp"
        android:clickable="true"
        android:focusable="true">

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/btn_add"
            android:textSize="28sp"
            android:textColor="@color/monet_on_primary_container"
            android:textStyle="bold" />
    </FrameLayout>

</FrameLayout>