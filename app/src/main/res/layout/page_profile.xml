<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 用户信息卡片 (24dp large radius) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_ios_card"
            android:elevation="0dp"
            android:padding="24dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_tab_profile"
                android:padding="12dp"
                android:background="@drawable/bg_badge_on"
                android:contentDescription="头像" />

            <TextView
                android:id="@+id/tv_profile_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/ios_primary_label"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tv_profile_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/ios_secondary_label"
                android:layout_marginTop="4dp"
                android:text="已坚持 0 天" />
        </LinearLayout>

        <!-- 数据统计栏 - 三个等宽微型卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stat_mini_card"
                android:padding="16dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/tv_stat_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/monet_primary"
                    android:text="0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/ios_secondary_label"
                    android:layout_marginTop="4dp"
                    android:text="总习惯数" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stat_mini_card"
                android:padding="16dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp">

                <TextView
                    android:id="@+id/tv_stat_today"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/monet_primary"
                    android:text="0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/ios_secondary_label"
                    android:layout_marginTop="4dp"
                    android:text="今日完成" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_stat_mini_card"
                android:padding="16dp"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/tv_stat_max_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/monet_primary"
                    android:text="0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/ios_secondary_label"
                    android:layout_marginTop="4dp"
                    android:text="最长连续" />
            </LinearLayout>
        </LinearLayout>

        <!-- 成就徽章 - 带背景色的圆形容器 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_ios_card"
            android:elevation="0dp"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/badge_bronze"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/iv_badge_bronze"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_badge_bronze"
                    android:padding="12dp"
                    android:background="@drawable/bg_badge_off"
                    android:contentDescription="铜牌" />

                <TextView
                    android:id="@+id/tv_badge_bronze"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/ios_secondary_label"
                    android:text="坚持一周"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/badge_silver"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/iv_badge_silver"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_badge_silver"
                    android:padding="12dp"
                    android:background="@drawable/bg_badge_off"
                    android:contentDescription="银牌" />

                <TextView
                    android:id="@+id/tv_badge_silver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/ios_secondary_label"
                    android:text="月度达人"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/badge_gold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/iv_badge_gold"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_badge_gold"
                    android:padding="12dp"
                    android:background="@drawable/bg_badge_off"
                    android:contentDescription="金牌" />

                <TextView
                    android:id="@+id/tv_badge_gold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/ios_secondary_label"
                    android:text="百日英雄"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 设置：每日提醒 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_ios_card"
            android:elevation="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:minHeight="52dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="每日提醒"
                    android:textSize="15sp"
                    android:textColor="@color/ios_primary_label" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_reminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/ios_thumb_tint"
                    app:trackTint="@color/ios_track_tint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_reminder_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="提醒时间"
                    android:textSize="15sp"
                    android:textColor="@color/ios_secondary_label" />

                <TextView
                    android:id="@+id/tv_reminder_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20:00"
                    android:textSize="15sp"
                    android:textColor="@color/ios_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=">"
                    android:textSize="15sp"
                    android:textColor="@color/ios_secondary_label"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 退出登录 - MD3 Error Container style, pill shape -->
        <Button
            android:id="@+id/item_logout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/label_logout"
            android:textSize="15sp"
            android:textColor="@color/ios_secondary_label"
            android:background="@drawable/bg_btn_outlined"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:elevation="0dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>