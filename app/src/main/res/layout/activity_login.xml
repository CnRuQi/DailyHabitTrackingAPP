<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg"
    android:fillViewport="true"
    tools:context=".LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- 品牌展示 - 增加呼吸感 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_emoji"
                android:textSize="48sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/ios_primary_label"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_subtitle"
                android:textSize="14sp"
                android:textColor="@color/ios_secondary_label"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- 用户名输入框 - MD3 Outlined style -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_ios_card"
            android:elevation="0dp"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用户名"
                android:textSize="12sp"
                android:textColor="@color/monet_primary"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/ed_username"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_username"
                android:textSize="15sp"
                android:textColor="@color/ios_primary_label"
                android:textColorHint="@color/ios_secondary_label"
                android:background="@android:color/transparent"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/monet_primary"
                android:alpha="0.3"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 密码输入框 - MD3 Outlined style -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_ios_card"
            android:elevation="0dp"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="密码"
                android:textSize="12sp"
                android:textColor="@color/monet_primary"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/ed_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/hint_password"
                android:inputType="textPassword"
                android:textSize="15sp"
                android:textColor="@color/ios_primary_label"
                android:textColorHint="@color/ios_secondary_label"
                android:background="@android:color/transparent"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/monet_primary"
                android:alpha="0.3"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 记住我 - MD3 Checkbox -->
        <CheckBox
            android:id="@+id/cb_remember"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/remember_me"
            android:textSize="13sp"
            android:textColor="@color/ios_secondary_label"
            android:buttonTint="@color/monet_primary"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <!-- 登录按钮 - 全圆角 Primary 填充 -->
        <Button
            android:id="@+id/bt_login"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:text="@string/btn_login"
            android:textSize="15sp"
            android:textColor="@color/monet_on_primary"
            android:background="@drawable/bg_btn_primary"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:elevation="0dp" />

        <!-- 分割线 "或" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/monet_outline_variant"
                android:alpha="0.5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_or"
                android:textSize="13sp"
                android:textColor="@color/ios_secondary_label"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/monet_outline_variant"
                android:alpha="0.5" />
        </LinearLayout>

        <!-- 创建新账户 - Outlined 边框样式 -->
        <Button
            android:id="@+id/bt_register"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:text="@string/btn_create_account"
            android:textSize="15sp"
            android:textColor="@color/monet_primary"
            android:background="@drawable/bg_btn_outlined"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:elevation="0dp" />

    </LinearLayout>

</ScrollView>