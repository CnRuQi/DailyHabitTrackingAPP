<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Monet Typography -->
    <style name="IOSTitle" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/monet_on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="IOSBody" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/monet_on_surface</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="IOSCaption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/monet_on_surface_variant</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="IOSHint" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:textColorHint">@color/monet_on_surface_variant</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Monet Card Style (Filled Card - no elevation, uses Surface Container) -->
    <style name="IOSCardStyle">
        <item name="android:background">@drawable/bg_ios_card</item>
        <item name="android:elevation">0dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Monet Input Style (Outlined, 12dp corner) -->
    <style name="IOSInputStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/ios_box_stroke_color</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="android:textColorHint">@color/monet_on_surface_variant</item>
        <item name="hintTextColor">@color/monet_primary</item>
        <item name="boxBackgroundColor">@android:color/transparent</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- Monet Primary Button (Pill shape, 40dp height) -->
    <style name="IOSButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/monet_on_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Monet Ghost Button -->
    <style name="IOSButtonGhost" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">@color/monet_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Monet Danger Button -->
    <style name="IOSButtonDanger" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:background">@drawable/bg_btn_danger</item>
        <item name="android:textColor">@color/monet_red</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Monet Switch Style (Primary container accent) -->
    <style name="IOSSwitch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="trackTint">@color/ios_track_tint</item>
        <item name="thumbTint">@color/ios_thumb_tint</item>
    </style>

    <!-- Rounded Corner Image (8dp) -->
    <style name="RoundedCornerImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- Bottom Navigation Text Styles -->
    <style name="BottomNavActive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/monet_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="BottomNavInactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/monet_on_surface_variant</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>